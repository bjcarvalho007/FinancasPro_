{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-alerts?mode=bills",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/check-alerts?mode=smart",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/check-alerts?mode=bills",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/check-alerts?mode=smart",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/check-alerts?mode=bills",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/check-alerts?mode=smart",
      "schedule": "0 0 * * *"
    }
  ]
}
